# Copy to secrets.yaml (same folder) and fill in the values.
# Do not commit secrets.yaml.

wifi_ssid: "YOUR_WIFI"
wifi_password: "YOUR_PASSWORD"

# openssl rand -base64 32
api_encryption_key: "GENERATE_AND_FILL_IN"

ota_password: "SECURE_OTA_PASSWORD"
fallback_ap_password: "SEPARATE_SECURE_FALLBACK_PASSWORD"
web_server_username: "DEVICE_WEB_USER"
web_server_password: "SEPARATE_SECURE_WEB_PASSWORD"

# Required by the active IR meter. Use a dedicated, topic-restricted publisher account.
# Stock ESPHome MQTT on ESP8266 is plaintext: isolate this listener/network.
mqtt_broker: "192.168.1.10"
mqtt_username: "MQTT_USER"
mqtt_password: "MQTT_PASSWORD"
